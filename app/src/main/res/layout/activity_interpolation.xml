<?xml version="1.0" encoding="utf-8"?>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/materialToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#3652ED"
            app:title="Interpolation Calculation"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/alculate_24"/>
    </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize">

        <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_green">

            <LinearLayout
                android:id="@+id/mainLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/editTextX1"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/edittext_border"
                        android:ems="10"
                        android:hint="@string/x1_"
                        android:inputType="number|numberDecimal|numberSigned"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/editTextY1"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/edittext_border"
                        android:ems="10"
                        android:hint="Y1"
                        android:inputType="number|numberDecimal|numberSigned"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textSize="20sp" />
            </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/editTextX"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/x"
                        android:ems="10"
                        android:hint="@string/x_"
                        android:inputType="number|numberDecimal|numberSigned"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/textViewResultYx"
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/y"
                        android:hint="@string/result"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textColor="#FF0000"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/editTextX2"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/edittext_border"
                        android:ems="10"
                        android:hint="@string/x2_"
                        android:inputType="number|numberSigned|numberDecimal"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/editTextY2"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:background="@drawable/edittext_border"
                        android:ems="10"
                        android:hint="@string/y2"
                        android:inputType="number|numberDecimal|numberSigned"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textSize="20sp" />
                </LinearLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonClear"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="15dp"
                    android:contentDescription="@string/calculate"
                    app:srcCompat="@drawable/ic_clear"
                    app:backgroundTint="@color/turunc" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/textTrim"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="3"
                                android:background="@drawable/border_text"
                                android:padding="5dp"
                                android:text="@string/trimint"
                                android:textAlignment="center"
                                android:textColor="@color/white"
                                android:textSize="30sp"
                                android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textView"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/border_text"
                                android:paddingTop="10dp"
                                android:text="@string/sounding"
                                android:textAlignment="center"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/editT1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edit_trim_border"
                                android:textColor="@color/white"
                                android:ems="10"
                                android:hint="@string/trim1"
                                android:textColorHint="@color/white"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <EditText
                                android:id="@+id/editT"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/x"
                                android:ems="10"
                                android:hint="@string/trim_"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <EditText
                                android:id="@+id/editT2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edit_trim_border"
                                android:textColor="@color/white"
                                android:ems="10"
                                android:hint="@string/trim2"
                                android:textColorHint="@color/white"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                            <EditText
                                android:id="@+id/editS1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edit_sound_border"
                                android:ems="10"
                                android:hint="@string/s1"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <EditText
                                android:id="@+id/editQ1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edittext_border"
                                android:ems="10"
                                android:hint="@string/q1"
                                android:autofillHints="Q1"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/textQ"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/y"
                                android:hint="@string/q"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textColor="#FF0000"
                                android:textSize="18sp" />

                            <EditText
                                android:id="@+id/editX1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edittext_border"
                                android:ems="10"
                                android:hint="@string/x1"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                            <EditText
                                android:id="@+id/editS"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/x"
                                android:ems="10"
                                android:hint="@string/s"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/textQS"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/y"
                                android:hint="@string/qs"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textColor="#FF0000"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/textQC"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/x"
                                android:hint="@string/result"
                                android:padding="10dp"
                                android:textStyle="bold"
                                android:textAlignment="center"
                                android:textColor="#FF0000"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/textXS"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/y"
                                android:hint="@string/xs"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textColor="#FF0000"
                                android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                            <EditText
                                android:id="@+id/editS2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edit_sound_border"
                                android:ems="10"
                                android:hint="@string/s2"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <EditText
                                android:id="@+id/editQ2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edittext_border"
                                android:ems="10"
                                android:hint="@string/q2"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/textQS2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/y"
                                android:hint="@string/qs2"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textColor="#FF0000"
                                android:textSize="18sp" />

                            <EditText
                                android:id="@+id/editX2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/edittext_border"
                                android:ems="10"
                                android:hint="@string/x2"
                                android:inputType="number|numberDecimal|numberSigned"
                                android:padding="10dp"
                                android:textAlignment="center"
                                android:textSize="18sp" />
            </LinearLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonClearTrim"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="15dp"
                    android:contentDescription="@string/calculate"
                    app:srcCompat="@drawable/ic_clear"
                    app:backgroundTint="@color/turunc" />
            </LinearLayout>
            </ScrollView>
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
